{
  "name": "@dsh-tui-ecosystem/music",
  "version": "0.1.0",
  "description": "Control YesPlayMusic TUI from dsh-TUI with /music commands and a compact now-playing bar",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-tui",
    "yesplaymusic",
    "music",
    "tui",
    "cordis"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nagi-ovo/dsh-music-tui.git"
  },
  "bugs": {
    "url": "https://github.com/Nagi-ovo/dsh-music-tui/issues"
  },
  "homepage": "https://github.com/Nagi-ovo/dsh-music-tui#readme",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "dsh-plugin.json",
    "README.md",
    "README_EN.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19 || >=24"
  },
  "packageManager": "pnpm@11.21.0",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "compile": "pnpm clean && tsc -p tsconfig.json",
    "build": "pnpm compile",
    "test": "pnpm build && pnpm verify:types && node --test test/*.test.mjs",
    "verify:types": "tsc -p tsconfig.consumer.json",
    "verify:package": "pnpm build && node scripts/verify-package.mjs",
    "verify:manifest": "pnpm build && node scripts/verify-manifest.mjs",
    "verify": "pnpm build && pnpm verify:types && node --test test/*.test.mjs && node scripts/verify-manifest.mjs && node scripts/verify-package.mjs",
    "prepack": "pnpm build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@dsh-std/sdk": "0.1.0-rc1",
    "fast-png": "8.0.0",
    "jpeg-js": "0.4.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-commands": "^0.1.0-rc.6 || ^0.1.1-rc.1 || ^0.1.2-alpha.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@deepseek-harness-tui/dsh-tui": "^0.9.2 || ^0.10.0-beta.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-commands": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@deepseek-harness-tui/dsh-tui": "^0.9.3 || ^0.10.0-beta.1",
    "@dsh-std/manifest": "0.1.0-rc1",
    "@types/node": "^24.0.0",
    "typescript": "6.0.3"
  }
}
